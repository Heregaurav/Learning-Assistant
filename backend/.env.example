GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
# Optional backwards-compatible Groq settings
LLM_API_KEY=
LLM_MODEL=qwen/qwen3.8-27b
LLM_BASE_URL=https://api.groq.com/openai/v1
MONGODB_URI=
DATABASE_NAME=learningAssistant
GOOGLE_CLIENT_ID=
# Optional: one-time first ADMIN bootstrap. Use an email verified by Google.
BOOTSTRAP_ADMIN_EMAIL=
# Optional assessment evaluator model; defaults to the selected provider's default.
EVALUATION_PROVIDER=groq
EVALUATION_MODEL=
# Tolerate small local clock differences when validating Google's iat/exp claims.
GOOGLE_CLOCK_SKEW_SECONDS=300
# Comma-separated browser origins allowed to call the API.
# Include the exact deployed frontend origin. Do not include a trailing slash.
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://your-frontend.vercel.app
# Optional for preview deployments. Prefer exact FRONTEND_ORIGINS in production.
FRONTEND_ORIGIN_REGEX=^https://[a-z0-9-]+\.vercel\.app$
# Cross-site frontend/backend deployments require Secure + SameSite=None cookies.
SESSION_COOKIE_SAMESITE=none
