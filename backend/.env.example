GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
# Optional backwards-compatible Groq settings
LLM_API_KEY=
LLM_MODEL=qwen/qwen3.8-27b
LLM_BASE_URL=https://api.groq.com/openai/v1
# Runtime: use Neon Console's pooled URL (-pooler endpoint) for web traffic.
DATABASE_URL=postgresql+psycopg://<user>:<password>@<endpoint>-pooler.<region>.aws.neon.tech/<database>?sslmode=require&channel_binding=require
# Schema migrations should use the separately configured direct Neon URL.
MIGRATION_DATABASE_URL=postgresql+psycopg://<user>:<password>@<endpoint>.<region>.aws.neon.tech/<database>?sslmode=require&channel_binding=require
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_RECYCLE_SECONDS=300
# Only needed by the explicit read-only Mongo-to-Postgres import command.
MONGODB_URI=
MONGODB_DATABASE=learningAssistant
GOOGLE_CLIENT_ID=
# Optional: one-time first ADMIN bootstrap. Use an email verified by Google.
BOOTSTRAP_ADMIN_EMAIL=
# Optional assessment evaluator model; defaults to the selected provider's default.
EVALUATION_PROVIDER=groq
EVALUATION_MODEL=
# Tolerate small local clock differences when validating Google's iat/exp claims.
GOOGLE_CLOCK_SKEW_SECONDS=300
# Comma-separated browser origins allowed to call the API.
# Include the exact deployed frontend origin. Do not include a trailing slash.
FRONTEND_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174,https://your-frontend.vercel.app
# Optional for preview deployments. Prefer exact FRONTEND_ORIGINS in production.
FRONTEND_ORIGIN_REGEX=^https://[a-z0-9-]+\.vercel\.app$
# Cross-site frontend/backend deployments require Secure + SameSite=None cookies.
APP_ENV=production
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=none
# Set only when frontend and API share a registrable parent domain.
SESSION_COOKIE_DOMAIN=
